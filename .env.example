# App
NODE_ENV=DEVELOPMENT
PORT=3000
CORS_ORIGIN_LOCAL=http://localhost:3000
CORS_ORIGIN_PROD=https://example.com

# Logger
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database
PGUSER=user
PGPASSWORD=password
PGHOST=localhost
PGPORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=replace-with-a-secure-random-secret

# Google APIs
GOOGLE_GEOLOCATION_API_KEY=
GOOGLE_GEOLOCATION_API_URL=https://www.googleapis.com/geolocation/v1/geolocate
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
GOOGLE_ROUTES_FIELD_MASK=routes.duration,routes.distanceMeters,routes.polyline.encodedPolyline

# Stripe
STRIPE_SECRET_KEY=

# Expo
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
